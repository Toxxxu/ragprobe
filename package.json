{
  "name": "ragprobe",
  "version": "0.3.1",
  "description": "Automated tests for AI assistants that answer from your documents: retrieval metrics, a local LLM judge, test set generation, and CI quality gates.",
  "type": "module",
  "license": "MIT",
  "author": "Toxxxu (https://github.com/Toxxxu)",
  "homepage": "https://github.com/Toxxxu/ragprobe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Toxxxu/ragprobe.git"
  },
  "bugs": {
    "url": "https://github.com/Toxxxu/ragprobe/issues"
  },
  "bin": {
    "ragprobe": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "pnpm run clean && pnpm run typecheck && pnpm test && pnpm run build",
    "dev": "tsx src/cli.ts",
    "example:server": "tsx examples/mock-rag-server.ts",
    "ollama:up": "docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d",
    "ollama:up:cpu": "docker compose up -d",
    "ollama:logs": "docker compose logs -f models",
    "ollama:down": "docker compose down",
    "example:eval": "tsx src/cli.ts run --dataset examples/dataset.jsonl --endpoint http://localhost:4010/query --k 3 --out reports"
  },
  "keywords": [
    "rag",
    "llm",
    "evaluation",
    "llm-evaluation",
    "retrieval",
    "llm-as-judge",
    "testing",
    "ci",
    "github-actions",
    "ollama",
    "langchain",
    "llamaindex"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0"
  }
}
